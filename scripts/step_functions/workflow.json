{
  "Comment": "Pipeline Completo de Detección de Fraude (Fase A + Fase B)",
  "StartAt": "GlueDataPreparation",
  "States": {
    "GlueDataPreparation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${glue_job_name}"
      },
      "Next": "SageMakerModelTraining",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PipelineFailed"
        }
      ]
    },
    "SageMakerModelTraining": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sagemaker:createTrainingJob",
      "Parameters": {
        "TrainingJobName.$": "States.Format('hybrid-train-{}', States.UUID())",
        "AlgorithmSpecification": {
          "TrainingImage": "763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.0.0-cpu-py310",
          "TrainingInputMode": "File"
        },
        "InputDataConfig": [
          {
            "ChannelName": "train",
            "DataSource": {
              "S3DataSource": {
                "S3DataType": "S3Prefix",
                "S3Uri": "s3://${curated_bucket}/silver/",
                "S3DataDistributionType": "FullyReplicated"
              }
            }
          }
        ],
        "OutputDataConfig": {
          "S3OutputPath": "s3://${curated_bucket}/models/"
        },
        "ResourceConfig": {
          "InstanceType": "ml.m5.xlarge",
          "InstanceCount": 1,
          "VolumeSizeInGB": 10
        },
        "RoleArn": "${sagemaker_role}",
        "StoppingCondition": {
          "MaxRuntimeInSeconds": 3600
        },
        "Environment": {
          "SAGEMAKER_PROGRAM": "train_hybrid.py",
          "SAGEMAKER_SUBMIT_DIRECTORY": "s3://${curated_bucket}/scripts/sourcedir.tar.gz"
        }
      },
      "End": true,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PipelineFailed"
        }
      ]
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Cause": "Error en el Pipeline de MLOps",
      "Error": "JobFailed"
    }
  }
}