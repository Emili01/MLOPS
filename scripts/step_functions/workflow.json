{
  "Comment": "Pipeline AWS Nativo: Detección de Fraude (Glue + SageMaker)",
  "StartAt": "GlueDataPreparation",
  "States": {
    "GlueDataPreparation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${glue_job_name}"
      },
      "Next": "SageMakerModelTraining"
    },
    "SageMakerModelTraining": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createTrainingJob.sync",
      "Parameters": {
        "TrainingJobName.$": "States.Format('hybrid-train-{}', States.UUID())",
        "AlgorithmSpecification": {
          "TrainingImage": "763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-training:2.0.0-cpu-py310",
          "TrainingInputMode": "File"
        },
        "RoleArn": "${sagemaker_role}",
        "InputDataConfig": [
          {
            "ChannelName": "train",
            "DataSource": {
              "S3DataSource": {
                "S3DataType": "S3Prefix",
                "S3Uri": "s3://${curated_bucket}/silver/",
                "S3DataDistributionType": "FullyReplicated"
              }
            }
          },
          {
            "ChannelName": "code",
            "DataSource": {
              "S3DataSource": {
                "S3DataType": "S3Prefix",
                "S3Uri": "s3://${curated_bucket}/scripts/sagemaker/",
                "S3DataDistributionType": "FullyReplicated"
              }
            }
          }
        ],
        "OutputDataConfig": {
          "S3OutputPath": "s3://${curated_bucket}/models/"
        },
        "ResourceConfig": {
          "InstanceType": "ml.m5.xlarge",
          "InstanceCount": 1,
          "VolumeSizeInGB": 10
        },
        "StoppingCondition": {
          "MaxRuntimeInSeconds": 3600
        },
        "HyperParameters": {
          "sagemaker_program": "train_hybrid.py",
          "sagemaker_submit_directory": "/opt/ml/input/data/code"
        }
      },
      "ResultPath": "$.TrainingResult",
      "Next": "RepackageModel"
    },
    "RepackageModel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${repackage_lambda_arn}",
        "Payload": {
          "model_s3_uri.$": "$.TrainingResult.ModelArtifacts.S3ModelArtifacts"
        }
      },
      "ResultSelector": {
        "fixed_model_uri.$": "$.Payload.fixed_model_uri"
      },
      "ResultPath": "$.RepackageResult",
      "Next": "SageMakerCreateModel"
    },
    "SageMakerCreateModel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createModel",
      "Parameters": {
        "ModelName.$": "States.Format('fraud-model-{}', States.UUID())",
        "PrimaryContainer": {
          "Image": "763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-inference:2.0.0-cpu-py310",
          "ModelDataUrl.$": "$.RepackageResult.fixed_model_uri",
          "Environment": {
            "SAGEMAKER_PROGRAM": "inference.py",
            "SAGEMAKER_SUBMIT_DIRECTORY": "/opt/ml/model"
          }
        },
        "ExecutionRoleArn": "${sagemaker_role}"
      },
      "ResultPath": "$.ModelResult",
      "Next": "ExtractModelName"
    },
    "ExtractModelName": {
      "Type": "Pass",
      "Parameters": {
        "ModelName.$": "States.ArrayGetItem(States.StringSplit($.ModelResult.ModelArn, '/'), 1)"
      },
      "ResultPath": "$.ExtractedModel",
      "Next": "SageMakerCreateEndpointConfig"
    },
    "SageMakerCreateEndpointConfig": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createEndpointConfig",
      "Parameters": {
        "EndpointConfigName.$": "States.Format('fraud-config-{}', States.UUID())",
        "ProductionVariants": [
          {
            "VariantName": "AllTraffic",
            "ModelName.$": "$.ExtractedModel.ModelName",
            "InitialInstanceCount": 1,
            "InstanceType": "ml.m5.large",
            "InitialVariantWeight": 1
          }
        ]
      },
      "ResultPath": "$.EndpointConfigResult",
      "Next": "SageMakerUpdateEndpoint"
    },
    "SageMakerUpdateEndpoint": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:updateEndpoint",
      "Parameters": {
        "EndpointName": "${endpoint_name}",
        "EndpointConfigName.$": "States.ArrayGetItem(States.StringSplit($.EndpointConfigResult.EndpointConfigArn, '/'), 1)"
      },
      "End": true
    }
  }
}